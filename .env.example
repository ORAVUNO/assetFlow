# Copy this file to `.env` and fill in your Elasticsearch credentials.
# `.env` is gitignored — never commit real credentials.

# --- Connection target (set ONE) ---
# Direct URL:
ELASTICSEARCH_URL=https://your-elasticsearch-host:9200
# ...or Elastic Cloud ID (leave URL blank if you use this):
# ELASTIC_CLOUD_ID=deployment-name:base64string

# --- Authentication (set ONE style) ---
# API key (recommended):
ELASTIC_API_KEY=your-base64-api-key
# ...or basic auth:
# ELASTIC_USERNAME=elastic
# ELASTIC_PASSWORD=your-password

# --- Optional TLS / timeout settings ---
# Path to a CA bundle if your cluster uses a private CA:
# ELASTIC_CA_CERTS=/path/to/ca.crt
# Set to false only for local testing with self-signed certs:
# ELASTIC_VERIFY_CERTS=true
# Request timeout in seconds:
# ELASTIC_REQUEST_TIMEOUT=60

# =============================================================================
# Tufin SecureTrack adapter (second adapter)
# =============================================================================
# A SecureTrack API user (host + username + password). Basic auth over the
# SecureTrack REST API at https://<host>/securetrack/api.
# TOS_HOSTNAME=securetrack.example.com
# TOS_USERNAME=securetrack-api-user
# TOS_PASSWORD=your-password

# --- Optional Tufin settings ---
# API base path (default /securetrack/api):
# TUFIN_BASE_PATH=/securetrack/api
# Set to false only for a lab/self-signed environment:
# TUFIN_VERIFY_CERTS=true
# Request timeout in seconds (default 30):
# TUFIN_REQUEST_TIMEOUT=30

# =============================================================================
# VMware vCenter adapter (third adapter)
# =============================================================================
# A vCenter user with read access to the inventory (host + username + password).
# Standard inventory (VMs, hosts, clusters, datastores, datacenters) is fetched
# over the vSphere Automation REST API at https://<host>/api. vCenter Custom
# Attributes (columns prefixed `custom.`) are read via pyVmomi when installed.
# VC_HOSTNAME=vcenter.example.com
# VC_USERNAME=administrator@vsphere.local
# VC_PASSWORD=your-password

# --- Optional VMware settings ---
# HTTPS port (default 443):
# VCENTER_PORT=443
# Set to false only for a lab/self-signed environment:
# VCENTER_VERIFY_CERTS=true
# Request timeout in seconds (default 60):
# VCENTER_REQUEST_TIMEOUT=60
#
# Custom Attributes need pyVmomi (optional). Install it with:
#   pip install pyvmomi
# or, on an offline server, from a local wheel:
#   pip install --no-index --find-links=. pyvmomi

# =============================================================================
# SolarWinds Orion adapter (fourth adapter)
# =============================================================================
# An Orion account with read access (host + username + password). Everything is
# fetched over the SolarWinds Information Service (SWIS) by running SWQL against
# https://<host>:17774/SolarWinds/InformationService/v3/Json/Query.
# Typed device inventory + custom properties (columns prefixed `custom.`) need
# only NPM; the config-posture, config-change, and compliance resources need NCM
# licensed and archiving configs.
# SWIS_HOSTNAME=solarwinds.example.com
# SWIS_USERNAME=orion-read-user
# SWIS_PASSWORD=your-password

# --- Optional SolarWinds settings ---
# SWIS query port (default 17774; older deployments use 17778):
# SWIS_PORT=17774
# Set to false only for a lab/self-signed environment:
# SWIS_VERIFY_CERTS=true
# Request timeout in seconds (default 120 — NCM config text can be large):
# SWIS_REQUEST_TIMEOUT=120

# =============================================================================
# Tenable.sc (SecurityCenter) adapter (fifth adapter)
# =============================================================================
# A Security Manager account with access to the required repositories. Everything
# is fetched over the Tenable.sc REST API at https://<host>/rest — the device
# inventory (sumip), aggregated security findings (vulndetails), installed
# software (listsoftware), users, asset lists (asset tags), alerts, and tickets
# (incidents). Connect with EITHER username + password (a session token) OR an
# access key + secret key (Tenable's preferred, session-less style).
# TENABLE_SC_HOST=tenable-sc.example.com
# TENABLE_SC_USERNAME=security-manager
# TENABLE_SC_PASSWORD=your-password
# ...or API keys (preferred; leave username/password blank if you use these):
# TENABLE_SC_ACCESS_KEY=your-access-key
# TENABLE_SC_SECRET_KEY=your-secret-key

# --- Optional Tenable.sc settings ---
# Path prefix in front of /rest, if your deployment sits behind one (default none):
# TENABLE_SC_API_PREFIX=
# Set to false only for a lab/self-signed environment:
# TENABLE_SC_VERIFY_CERTS=true
# Request timeout in seconds (default 60; raise it for very large fetches):
# TENABLE_SC_REQUEST_TIMEOUT=60
# Max records pulled per analysis fetch (default 1000000; 0 = truly unlimited):
# TENABLE_SC_MAX_RECORDS=1000000
# Analysis pagination page size (default 1000):
# TENABLE_SC_PAGE_SIZE=1000
# Stamp each device with the asset lists (tags) its IP belongs to (default true).
# Set false if you have very many asset lists and want the fastest device fetch:
# TENABLE_SC_DEVICE_TAGS=true
# How many asset lists to resolve for device tag stamping (default 200):
# TENABLE_SC_TAG_ASSET_CAP=200
# Which severities the Aggregated Security Findings view includes. Ids: 0=Info,
# 1=Low, 2=Medium, 3=High, 4=Critical. Default excludes Info (noise like "Ping
# the remote host"); set to "all" or "0,1,2,3,4" to include informational plugins:
# TENABLE_SC_FINDINGS_SEVERITIES=1,2,3,4
# Explore Assets (TSC009) drops bare "ping-only" hosts (known IPs with no name /
# OS / MAC / repository) by default. Set true to include every listed IP:
# TENABLE_SC_HOSTS_INCLUDE_BARE=false
