# Copy this file to `.env` and fill in your Elasticsearch credentials.
# `.env` is gitignored — never commit real credentials.

# --- Connection target (set ONE) ---
# Direct URL:
ELASTICSEARCH_URL=https://your-elasticsearch-host:9200
# ...or Elastic Cloud ID (leave URL blank if you use this):
# ELASTIC_CLOUD_ID=deployment-name:base64string

# --- Authentication (set ONE style) ---
# API key (recommended):
ELASTIC_API_KEY=your-base64-api-key
# ...or basic auth:
# ELASTIC_USERNAME=elastic
# ELASTIC_PASSWORD=your-password

# --- Optional TLS / timeout settings ---
# Path to a CA bundle if your cluster uses a private CA:
# ELASTIC_CA_CERTS=/path/to/ca.crt
# Set to false only for local testing with self-signed certs:
# ELASTIC_VERIFY_CERTS=true
# Request timeout in seconds:
# ELASTIC_REQUEST_TIMEOUT=60

# =============================================================================
# Tufin SecureTrack adapter (second adapter)
# =============================================================================
# A SecureTrack API user (host + username + password). Basic auth over the
# SecureTrack REST API at https://<host>/securetrack/api.
# TOS_HOSTNAME=securetrack.example.com
# TOS_USERNAME=securetrack-api-user
# TOS_PASSWORD=your-password

# --- Optional Tufin settings ---
# API base path (default /securetrack/api):
# TUFIN_BASE_PATH=/securetrack/api
# Set to false only for a lab/self-signed environment:
# TUFIN_VERIFY_CERTS=true
# Request timeout in seconds (default 30):
# TUFIN_REQUEST_TIMEOUT=30

# =============================================================================
# VMware vCenter adapter (third adapter)
# =============================================================================
# A vCenter user with read access to the inventory (host + username + password).
# Standard inventory (VMs, hosts, clusters, datastores, datacenters) is fetched
# over the vSphere Automation REST API at https://<host>/api. vCenter Custom
# Attributes (columns prefixed `custom.`) are read via pyVmomi when installed.
# VC_HOSTNAME=vcenter.example.com
# VC_USERNAME=administrator@vsphere.local
# VC_PASSWORD=your-password

# --- Optional VMware settings ---
# HTTPS port (default 443):
# VCENTER_PORT=443
# Set to false only for a lab/self-signed environment:
# VCENTER_VERIFY_CERTS=true
# Request timeout in seconds (default 60):
# VCENTER_REQUEST_TIMEOUT=60
#
# Custom Attributes need pyVmomi (optional). Install it with:
#   pip install pyvmomi
# or, on an offline server, from a local wheel:
#   pip install --no-index --find-links=. pyvmomi
