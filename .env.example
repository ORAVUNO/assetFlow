# Copy this file to `.env` and fill in your Elasticsearch credentials.
# `.env` is gitignored — never commit real credentials.

# --- Connection target (set ONE) ---
# Direct URL:
ELASTICSEARCH_URL=https://your-elasticsearch-host:9200
# ...or Elastic Cloud ID (leave URL blank if you use this):
# ELASTIC_CLOUD_ID=deployment-name:base64string

# --- Authentication (set ONE style) ---
# API key (recommended):
ELASTIC_API_KEY=your-base64-api-key
# ...or basic auth:
# ELASTIC_USERNAME=elastic
# ELASTIC_PASSWORD=your-password

# --- Optional TLS / timeout settings ---
# Path to a CA bundle if your cluster uses a private CA:
# ELASTIC_CA_CERTS=/path/to/ca.crt
# Set to false only for local testing with self-signed certs:
# ELASTIC_VERIFY_CERTS=true
# Request timeout in seconds:
# ELASTIC_REQUEST_TIMEOUT=60

# =============================================================================
# Tufin SecureTrack adapter (second adapter)
# =============================================================================
# A SecureTrack API user (host + username + password). Basic auth over the
# SecureTrack REST API at https://<host>/securetrack/api.
# TOS_HOSTNAME=securetrack.example.com
# TOS_USERNAME=securetrack-api-user
# TOS_PASSWORD=your-password

# --- Optional Tufin settings ---
# API base path (default /securetrack/api):
# TUFIN_BASE_PATH=/securetrack/api
# Set to false only for a lab/self-signed environment:
# TUFIN_VERIFY_CERTS=true
# Request timeout in seconds (default 30):
# TUFIN_REQUEST_TIMEOUT=30

# =============================================================================
# VMware vCenter adapter (third adapter)
# =============================================================================
# A vCenter user with read access to the inventory (host + username + password).
# Standard inventory (VMs, hosts, clusters, datastores, datacenters) is fetched
# over the vSphere Automation REST API at https://<host>/api. vCenter Custom
# Attributes (columns prefixed `custom.`) are read via pyVmomi when installed.
# VC_HOSTNAME=vcenter.example.com
# VC_USERNAME=administrator@vsphere.local
# VC_PASSWORD=your-password

# --- Optional VMware settings ---
# HTTPS port (default 443):
# VCENTER_PORT=443
# Set to false only for a lab/self-signed environment:
# VCENTER_VERIFY_CERTS=true
# Request timeout in seconds (default 60):
# VCENTER_REQUEST_TIMEOUT=60
#
# Custom Attributes need pyVmomi (optional). Install it with:
#   pip install pyvmomi
# or, on an offline server, from a local wheel:
#   pip install --no-index --find-links=. pyvmomi

# =============================================================================
# SolarWinds Orion adapter (fourth adapter)
# =============================================================================
# An Orion account with read access (host + username + password). Everything is
# fetched over the SolarWinds Information Service (SWIS) by running SWQL against
# https://<host>:17774/SolarWinds/InformationService/v3/Json/Query.
# Typed device inventory + custom properties (columns prefixed `custom.`) need
# only NPM; the config-posture, config-change, and compliance resources need NCM
# licensed and archiving configs.
# SWIS_HOSTNAME=solarwinds.example.com
# SWIS_USERNAME=orion-read-user
# SWIS_PASSWORD=your-password

# --- Optional SolarWinds settings ---
# SWIS query port (default 17774; older deployments use 17778):
# SWIS_PORT=17774
# Set to false only for a lab/self-signed environment:
# SWIS_VERIFY_CERTS=true
# Request timeout in seconds (default 120 — NCM config text can be large):
# SWIS_REQUEST_TIMEOUT=120

# =============================================================================
# Tenable.sc (SecurityCenter) adapter (fifth adapter)
# =============================================================================
# A Security Manager account with access to the required repositories. Everything
# is fetched over the Tenable.sc REST API at https://<host>/rest — the device
# inventory (sumip), aggregated security findings (vulndetails), installed
# software (listsoftware), users, asset lists (asset tags), alerts, and tickets
# (incidents). Connect with EITHER username + password (a session token) OR an
# access key + secret key (Tenable's preferred, session-less style).
# TENABLE_SC_HOST=tenable-sc.example.com
# TENABLE_SC_USERNAME=security-manager
# TENABLE_SC_PASSWORD=your-password
# ...or API keys (preferred; leave username/password blank if you use these):
# TENABLE_SC_ACCESS_KEY=your-access-key
# TENABLE_SC_SECRET_KEY=your-secret-key

# --- Optional Tenable.sc settings ---
# Path prefix in front of /rest, if your deployment sits behind one (default none):
# TENABLE_SC_API_PREFIX=
# Set to false only for a lab/self-signed environment:
# TENABLE_SC_VERIFY_CERTS=true
# Request timeout in seconds (default 60; raise it for very large fetches):
# TENABLE_SC_REQUEST_TIMEOUT=60
# Max records pulled per analysis fetch (default 1000000; 0 = truly unlimited):
# TENABLE_SC_MAX_RECORDS=1000000
# Analysis pagination page size (default 1000):
# TENABLE_SC_PAGE_SIZE=1000
# Stamp each device with the asset lists (tags) its IP belongs to (default true).
# Set false if you have very many asset lists and want the fastest device fetch:
# TENABLE_SC_DEVICE_TAGS=true
# How many asset lists to resolve for device tag stamping (default 200):
# TENABLE_SC_TAG_ASSET_CAP=200
# Which severities the Aggregated Security Findings view includes. Ids: 0=Info,
# 1=Low, 2=Medium, 3=High, 4=Critical. Default excludes Info (noise like "Ping
# the remote host"); set to "all" or "0,1,2,3,4" to include informational plugins:
# TENABLE_SC_FINDINGS_SEVERITIES=1,2,3,4
# Explore Assets (TSC009) drops bare "ping-only" hosts (known IPs with no name /
# OS / MAC / repository) by default. Set true to include every listed IP:
# TENABLE_SC_HOSTS_INCLUDE_BARE=false
# Extra application-name keywords for the Applications (TSC011) view, appended to
# the built-in allowlist (comma-separated), to keep site-specific apps:
# TENABLE_SC_APP_KEYWORDS=myapp,acme-agent,inhouse-portal

# =============================================================================
# ManageEngine AssetExplorer adapter (sixth adapter)
# =============================================================================
# Everything is fetched over the AssetExplorer v3 REST API: the full asset
# inventory (default fields + custom UDF fields), bucketed into its asset types
# (servers, workstations, routers, switches, firewalls, access points, printers,
# storage, UPS, …), plus the CMDB configuration items, contracts, and purchase
# orders. Connect EITHER with OAuth (AssetExplorer Cloud) OR a technician API key
# (on-premises AssetExplorer).
# AE_HOST=assetexplorer.example.com
# On-premises often runs plain HTTP and/or a custom port — include the scheme/port
# and it is honored (https is the default when no scheme is given):
# AE_HOST=http://assetexplorer.corp:8080
# --- AssetExplorer Cloud (OAuth) ---
# The portal (Cloud only; the segment after /app/ in the account URL):
# AE_PORTAL=itdesk
# A current OAuth access token (short-lived)...
# AE_ACCESS_TOKEN=your-access-token
# ...or, preferred, a long-lived refresh token with its OAuth client id/secret so
# the adapter mints fresh access tokens on demand (survives token expiry):
# AE_REFRESH_TOKEN=your-refresh-token
# AE_CLIENT_ID=your-oauth-client-id
# AE_CLIENT_SECRET=your-oauth-client-secret
# --- On-premises AssetExplorer (technician API key) ---
# Leave AE_PORTAL blank and set the technician key (Personalize -> API):
# AE_API_KEY=your-technician-api-key

# --- Optional AssetExplorer settings ---
# Zoho accounts server used for OAuth token refresh; pick your data center:
#   US https://accounts.zoho.com  ·  EU https://accounts.zoho.eu  ·
#   IN https://accounts.zoho.in   ·  AU https://accounts.zoho.com.au  ·
#   JP https://accounts.zoho.jp   ·  CN https://accounts.zoho.com.cn
# AE_ACCOUNTS_URL=https://accounts.zoho.com
# Set to false only for a lab / self-signed on-prem environment:
# AE_VERIFY_CERTS=true
# Request timeout in seconds (default 60; raise it for very large fetches):
# AE_REQUEST_TIMEOUT=60
# List pagination page size (default 100 — AssetExplorer's per-page cap):
# AE_PAGE_SIZE=100
# Max records pulled per list fetch (default 1000000; 0 = truly unlimited):
# AE_MAX_RECORDS=1000000
# CI types the CMDB resource (AE015) fetches (comma-separated api names), to match
# your instance's configured CI types:
# AE_CMDB_CI_TYPES=server,workstation,router,switch,firewall,access_point,printer,storage,ups,network_device,database,application,business_service
# Fields requested from the assets list endpoint. The list endpoint only returns
# the fields you name here — without a projection, relational fields (serial, MAC,
# OS, category, dates) come back empty. Override the built-in broad set, or set to
# "none" to send no projection (the raw default). A rejected field name makes the
# fetch retry without the projection:
# AE_ASSET_FIELDS=name,ip_addresses,serial_number,product_type,udf_fields,...
# Friendly labels for custom (UDF) fields, so columns read "BCM Rating" instead of
# "custom.udf_pick_8909". Either inline JSON, or @path to a JSON file. UDF labels
# are deployment-specific; see config/assetexplorer_udf_labels.example.json. The
# adapter also tries to read these from AssetExplorer's field metadata automatically:
# AE_UDF_LABELS=@config/assetexplorer_udf_labels.example.json
# (Zero-config alternative: copy that file to config/assetexplorer_udf_labels.json
#  and it is auto-loaded without setting AE_UDF_LABELS at all.)
# Seconds one asset scan is reused across resources in a run. "Fetch all" runs
# assets + every asset-type bucket back to back; caching the scan for this long
# means the estate is fetched once, not once per resource (avoids timeouts on big
# estates). Set 0 to disable caching:
# AE_ASSET_CACHE_TTL=120

# =============================================================================
# Microsoft Active Directory adapter (seventh adapter)
# =============================================================================
# On-prem AD DS is queried over LDAP. Fetches users, groups, organizational
# units, computers, job titles, the domain, managed service accounts, AD CS
# certificate templates / CAs / published certs, and AD-integrated DNS zones and
# records. Needs the 'ldap3' package installed (pip install ldap3); certificate
# subject/issuer/validity parsing additionally uses 'cryptography' when present.
# AD_HOST=dc01.corp.local
# AD_USERNAME=svc-assetflow@corp.local
# AD_PASSWORD=your-password

# --- Optional Active Directory settings ---
# Search base (default: RootDSE defaultNamingContext, auto-detected on connect):
# AD_BASE_DN=DC=corp,DC=local
# LDAP port (default 636 for LDAPS, else 389):
# AD_PORT=636
# Use LDAPS (default true; set false for plain LDAP on port 389):
# AD_USE_SSL=true
# Validate the LDAPS server certificate (default true; false for lab/self-signed):
# AD_VERIFY_CERTS=true
# Connection/receive timeout in seconds (default 30):
# AD_REQUEST_TIMEOUT=30
# LDAP paged-search page size (default 1000):
# AD_PAGE_SIZE=1000
