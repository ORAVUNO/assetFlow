# Copy this file to `.env` and fill in your Elasticsearch credentials.
# `.env` is gitignored — never commit real credentials.

# --- Connection target (set ONE) ---
# Direct URL:
ELASTICSEARCH_URL=https://your-elasticsearch-host:9200
# ...or Elastic Cloud ID (leave URL blank if you use this):
# ELASTIC_CLOUD_ID=deployment-name:base64string

# --- Authentication (set ONE style) ---
# API key (recommended):
ELASTIC_API_KEY=your-base64-api-key
# ...or basic auth:
# ELASTIC_USERNAME=elastic
# ELASTIC_PASSWORD=your-password

# --- Optional TLS / timeout settings ---
# Path to a CA bundle if your cluster uses a private CA:
# ELASTIC_CA_CERTS=/path/to/ca.crt
# Set to false only for local testing with self-signed certs:
# ELASTIC_VERIFY_CERTS=true
# Request timeout in seconds:
# ELASTIC_REQUEST_TIMEOUT=60
